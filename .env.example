# ═══════════════════════════════════════════
# LOS 10.000 DE MACKO — Variables de Entorno
# ═══════════════════════════════════════════
# Copiá este archivo como .env y completá los valores

# ── Base de datos (PostgreSQL — Supabase) ──
# Obligatorio. La URL de conexión a tu base de datos.
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db?sslmode=require
# Por defecto el certificado TLS se valida. Solo para un entorno local con
# certificado propio puede usarse false; nunca en producción.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Opcional: certificado CA PEM entregado por el proveedor (admite saltos como \\n).
DATABASE_CA_CERT=

# ── Seguridad ─────────────────────────────
# Obligatorio. Cada secreto debe tener al menos 32 bytes y ser distinto. Generá uno seguro con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
CEO_SECRET=
# Opcionales: si se completan ambos, crean el primer administrador. Contraseña mínima: 14 caracteres.
CEO_ADMIN_USERNAME=
CEO_ADMIN_PASSWORD=

# ── Servidor ──────────────────────────────
# Opcional. Puerto del servidor (default: 3000)
PORT=3000

# Opcional. URL base para links de reset de contraseña
BASE_URL=http://localhost:3000

# ── Email (recuperación de contraseña) ────
# Obligatorio para que funcione "Olvidé mi contraseña"
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-contraseña-de-app-gmail
EMAIL_FROM="Macko Juegos <tu-email@gmail.com>"

# ── Stripe (OPCIONAL — para monetización USD) ──
# Solo si vas a procesar pagos internacionales.
# Stripe NO funciona directamente con cuentas argentinas.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Mercado Pago (RECOMENDADO para Argentina) ──
# Mejor opción para cobrar en ARS desde Argentina.
# Obtené tus credenciales en: https://www.mercadopago.com.ar/developers
MP_ACCESS_TOKEN=APP_USR-...  # Access Token de producción
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
# false para credenciales de prueba; validar contra el pago, nunca inferir por el token.
MP_LIVE_MODE=false
# No activar antes de completar las puertas de lanzamiento del plan.
PAYMENTS_ENABLED=false
PAID_COMPETITION_ENABLED=false
# Para pruebas: MP_ACCESS_TOKEN=TEST-...

# ── Push web (opcional) ─────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:tu-email@gmail.com
