# ═══════════════════════════════════════════
# LOS 10.000 DE MACKO — Variables de Entorno
# ═══════════════════════════════════════════
# Copiá este archivo como .env y completá los valores

# ── Base de datos (PostgreSQL Neon) ───────
# Obligatorio. La URL de conexión a tu base de datos.
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db?sslmode=require

# ── Seguridad ─────────────────────────────
# Obligatorio. Secreto para firmar JWTs. Generá uno seguro con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Servidor ──────────────────────────────
# Opcional. Puerto del servidor (default: 3000)
PORT=3000

# Opcional. URL base para links de reset de contraseña
BASE_URL=http://localhost:3000

# ── Email (recuperación de contraseña) ────
# Obligatorio para que funcione "Olvidé mi contraseña"
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-contraseña-de-app-gmail

# ── Stripe (OPCIONAL — para monetización USD) ──
# Solo si vas a procesar pagos internacionales.
# Stripe NO funciona directamente con cuentas argentinas.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Mercado Pago (RECOMENDADO para Argentina) ──
# Mejor opción para cobrar en ARS desde Argentina.
# Obtené tus credenciales en: https://www.mercadopago.com.ar/developers
MP_ACCESS_TOKEN=APP_USR-...  # Access Token de producción
# Para pruebas: MP_ACCESS_TOKEN=TEST-...
